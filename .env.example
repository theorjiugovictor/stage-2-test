# ── Image tags (compose uses these; falls back to building from source) ───────
API_IMAGE=api:latest
FRONTEND_IMAGE=frontend:latest

# ── Redis connection ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── API ───────────────────────────────────────────────────────────────────────
# URL the frontend uses to reach the API (internal Docker network name)
API_URL=http://api:8000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port that maps to the frontend container port 3000
FRONTEND_PORT=3000

# ── Resource limits ───────────────────────────────────────────────────────────
REDIS_CPU_LIMIT=0.50
REDIS_MEMORY_LIMIT=128M

API_CPU_LIMIT=1.00
API_MEMORY_LIMIT=256M

FRONTEND_CPU_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=128M
